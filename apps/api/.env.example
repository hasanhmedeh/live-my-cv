# Copy this file to apps/api/.env and adjust (the first `pnpm dev` makes that copy for you).
# The API and the Prisma CLI both read it.

# PostgreSQL connection string. `pnpm dev` creates the database if it does not exist yet.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/funfair

# Signs the session cookie. Use a long random string (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string

# Port the API listens on. The web dev server proxies /api to it.
PORT=3000

# Browser origin(s) allowed to call the API with cookies when it is not behind the
# same-origin /api proxy. Comma-separated, e.g. https://funfair.example,https://www.funfair.example
WEB_ORIGIN=http://localhost:5173

# development | production | test. In production the session cookie is marked Secure.
NODE_ENV=development

# Optional. Which proxies to trust for X-Forwarded-For, so rate limiting sees the visitor's
# real IP: an Express "trust proxy" value - a hop count (1 behind one load balancer),
# addresses/subnets ("loopback", "10.0.0.0/8"), true or false. Defaults to loopback.
# TRUST_PROXY=1
