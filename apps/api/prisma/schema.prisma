// Accounts, tickets and ride rounds for The Funfair.
// After editing: `pnpm db:migrate --name <change>` to write a migration, then `pnpm db:generate`.
// Ticket prices and each attraction's open/maintenance switch (attraction_settings), and the pack
// size, purchase cooldown and park-wide open/closed switch (park_settings) are rows, edited in The
// Ringmaster's Office (/ringmaster) or Prisma Studio.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (read from DATABASE_URL).
datasource db {
  provider = "postgresql"
}

/// Everything that takes a ticket: the rides and the games. Mirrors the zone ids in apps/web/src/world/layout.ts.
enum Attraction {
  coaster
  falcon
  rocket
  ferris
  flip
  ship
  speedway
  drone
  crates
  striker

  @@map("attraction")
}

/// What an account may do. Admins ("staff") get The Ringmaster's Office (/ringmaster) and can still
/// board and buy while the park is closed. Appointed with `pnpm staff:appoint <email>`.
enum Role {
  player
  admin

  @@map("role")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  /// Display spelling, as typed at signup.
  username        String
  /// Lowercased username, so "Hasan" and "hasan" can't both exist.
  usernameKey     String           @unique @map("username_key")
  passwordHash    String           @map("password_hash")
  /// Tickets left to spend. Never negative (a CHECK constraint backs that up).
  ticketBalance   Int              @default(0) @map("ticket_balance")
  /// When the last pack was bought. The next one is allowed park_settings.cooldown_hours later.
  lastPurchaseAt  DateTime?        @map("last_purchase_at")
  /// When the user accepted the Terms of Service and Privacy Policy, and which version.
  /// Null for accounts created before signup asked for it.
  termsAcceptedAt DateTime?        @map("terms_accepted_at")
  termsVersion    String?          @map("terms_version")
  role            Role             @default(player)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  purchases       TicketPurchase[]
  rounds          RideRound[]
  adminActions    AdminAction[]

  @@index([createdAt])
  @@map("users")
}

/// One pack of tickets bought. Free for now (price 0, provider "free"), but recorded like a sale
/// so real payments can slot in later.
model TicketPurchase {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity     Int
  priceCents   Int      @map("price_cents")
  currency     String
  provider     String
  /// The user's ticket balance right after this purchase.
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ticket_purchases")
}

/// Each attraction's price and whether it is running. The migrations seed every attraction; edit a
/// row (in The Ringmaster's Office, or e.g. with `pnpm studio:prod`) to change a price or close a
/// ride for maintenance without a deploy. Rounds keep what they cost at the time in
/// ride_rounds.tickets_spent. An attraction without a row costs its default (rides/attractions.ts).
model AttractionSettings {
  attraction    Attraction @id
  /// Tickets per round, at least 1 (a CHECK constraint in the migration).
  tickets       Int
  /// False while it is closed for maintenance: the game shows it under maintenance and boarding
  /// stops (staff can still board, to test it).
  open          Boolean    @default(true)
  /// Shown to visitors while it is closed, e.g. "New brakes going in, back tomorrow".
  closedMessage String?    @map("closed_message")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  @@map("attraction_settings")
}

/// The park's switches, in a single row (id 1, enforced by a CHECK in the migration). Edit it, e.g.
/// with `pnpm studio:prod`, to close the park without a deploy: the game shows the closed sign,
/// and boarding and ticket sales stop (staff can still do both). Accounts keep working.
/// Without the row the API treats the park as open, with the column defaults below.
model ParkSettings {
  id            Int      @id @default(1)
  open          Boolean  @default(true)
  /// Shown to visitors while the park is closed, e.g. "Closed for maintenance, back at 18:00".
  closedMessage String?  @map("closed_message")
  /// Tickets in one pack, 1 to 1000 (a CHECK constraint in the migration).
  packSize      Int      @default(20) @map("pack_size")
  /// Hours between two purchases, counted from the last one: 0 (no wait) to 168 (a CHECK constraint).
  cooldownHours Int      @default(5) @map("cooldown_hours")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("park_settings")
}

/// One paid go on one attraction: tickets are spent when it starts. It is open until the game
/// reports the result (endedAt, completed, stats), or until the user boards something else,
/// which closes it as abandoned (completed false, no stats).
model RideRound {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride         Attraction
  ticketsSpent Int        @map("tickets_spent")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  completed    Boolean    @default(false)
  /// What the game measured, e.g. { "topSpeedKmh": 92.4, "maxG": 3.1 }: a flat object of numbers,
  /// client-reported, so informational only.
  stats        Json?

  @@index([userId, ride])
  @@index([userId, endedAt])
  @@index([startedAt])
  @@map("ride_rounds")
}

/// The Ringmaster's Office logbook: one row per change made by staff (or by `pnpm staff:*`).
model AdminAction {
  id        String   @id @default(cuid())
  /// Who did it. Set to null when that account is deleted; actorName still says who it was.
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// The actor's username at the time, or "cli" for the staff scripts.
  actorName String   @map("actor_name")
  /// What happened: park.open, park.close, settings.update, attraction.open, attraction.close,
  /// price.update, attraction.update, user.tickets, user.role, user.cooldown or user.delete.
  action    String
  /// What it happened to: an attraction id or a user's email. Null for the park's settings.
  target    String?
  /// Before and after, e.g. { "before": { "tickets": 5 }, "after": { "tickets": 3 } }.
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_actions")
}
